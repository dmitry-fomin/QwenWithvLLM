# HuggingFace Token для загрузки моделей
# Получить: https://huggingface.co/settings/tokens
# Используется в: bash scripts/download_model.sh
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Путь где хранятся загруженные модели
# Используется при запуске vLLM
# Примеры:
#   /data/models
#   /mnt/ssd/models
#   ./models
MODELS_DIR=./models

# Сервер URL для клиента
# Примеры:
#   http://localhost:8000/v1          (локальный сервер)
#   http://192.168.1.100:8000/v1     (сервер в сети)
#   https://example.com:8000/v1      (удалённый сервер)
VLLM_SERVER_URL=http://localhost:8000/v1

# Имя модели (должно совпадать с --served-model-name в vLLM)
VLLM_MODEL_NAME=qwen3-vl-8b
