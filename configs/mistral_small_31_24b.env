# Mistral Small 3.1 24B W4A16 (RedHatAI) — компактный мультимодальный
# VRAM: ~12 GB INT4 → ~6 GB/GPU при TP=2 — максимальный запас на KV-кеш
# Особенности: vision + text, быстрый, длинный контекст 128k
# Квантизация: compressed-tensors W4A16 (INT4 веса, BF16 активации)

MODEL_PATH=RedHatAI/Mistral-Small-3.1-24B-Instruct-2503-quantized.w4a16
MODEL_NAME=mistral-small-24b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code --quantization compressed-tensors"
MM_IMAGE_LIMIT=5
