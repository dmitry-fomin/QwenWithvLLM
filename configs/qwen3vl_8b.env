# Qwen3-VL-8B — лучший выбор для UI/OCR на 2x RTX 5090
# VRAM: ~17 GB BF16 (комфортно влезает)
# Отлично для: скриншоты, OCR, описание UI элементов, UI-агент

MODEL_PATH=Qwen/Qwen3-VL-8B-Instruct
MODEL_NAME=qwen3-vl-8b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code --limit-mm-per-prompt image=10"
