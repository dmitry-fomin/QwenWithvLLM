# Qwen3-VL-8B — лучший выбор для UI/OCR на 2x RTX 5090
# VRAM: ~17 GB BF16 (комфортно влезает)
# Отлично для: универсальный выбор (SOTA для своего размера), лучший OCR

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=Qwen/Qwen3-VL-8B-Instruct
MODEL_NAME=qwen3-vl-8b
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.85
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=10
