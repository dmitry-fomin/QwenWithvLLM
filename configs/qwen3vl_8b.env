# Qwen3-VL-8B — лёгкая SOTA модель для UI/OCR
# VRAM: ~17 GB BF16 (помещается даже на 1 GPU, на 2× — с огромным запасом)
# Отлично для: универсальный выбор (SOTA для своего размера), лучший OCR
# Hardware: 2× RTX 5090 (36 GB) — можно длинный контекст

MODEL_PATH=Qwen/Qwen3-VL-8B-Instruct
MODEL_NAME=qwen3-vl-8b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=20
