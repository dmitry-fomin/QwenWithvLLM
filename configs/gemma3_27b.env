# Gemma 3 27B W4A16 (RedHatAI) — мультимодальный reasoning + vision
# VRAM: ~14 GB INT4 → ~7 GB/GPU при TP=2 — огромный запас на KV-кеш
# Особенности: vision + text, сильный reasoning, контекст 128k
# Квантизация: compressed-tensors W4A16 (INT4 веса, BF16 активации)

MODEL_PATH=RedHatAI/gemma-3-27b-it-quantized.w4a16
MODEL_NAME=gemma3-27b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code --quantization compressed-tensors"
MM_IMAGE_LIMIT=5
