# Llama 4 Scout 17B-16E FP8 (RedHatAI) — мультимодальный MoE
# VRAM: ~109B всего параметров в FP8 → ~109 GB — НЕ ВЛЕЗАЕТ в 64 GB!
# ⚠️  Для запуска нужно минимум 2× H100 80GB или 4× RTX 5090
# Ждём W4A16/INT4 версию (~55 GB) — тогда влезет на 2× RTX 5090
# Следи за: huggingface.co/RedHatAI или neuralmagic для INT4-версии

MODEL_PATH=RedHatAI/Llama-4-Scout-17B-16E-Instruct-FP8-dynamic
MODEL_NAME=llama4-scout
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code --quantization fp8"
MM_IMAGE_LIMIT=5
