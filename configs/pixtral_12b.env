# Pixtral-12B (Mistral) — хороший баланс для чартов и документов
# VRAM: ~25 GB BF16
# Отлично для: чарты, диаграммы, естественные сцены, документы

MODEL_PATH=mistralai/Pixtral-12B-2409
MODEL_NAME=pixtral-12b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=5
