# Pixtral-12B (Mistral) — хороший баланс для чартов и документов
# VRAM: ~25 GB BF16
# Отлично для: отличный баланс между скоростью и качеством OCR

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=mistralai/Pixtral-12B-2409
MODEL_NAME=pixtral-12b
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.85
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=5
