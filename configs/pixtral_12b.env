# Pixtral-12B (Mistral) — хороший баланс для чартов и документов
# VRAM: ~25 GB BF16
# Отлично для: отличный баланс между скоростью и качеством OCR
# Hardware: 2× RTX 5090 (36 GB) — комфортно

MODEL_PATH=mistralai/Pixtral-12B-2409
MODEL_NAME=pixtral-12b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
VLLM_USE_V1=0
EXTRA_ARGS="--trust-remote-code --enable-prefix-caching --mm-processor-cache-gb 8"
MM_IMAGE_LIMIT=10
