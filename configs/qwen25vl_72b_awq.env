# Qwen2.5-VL-72B AWQ — максимальное качество OCR/UI
# VRAM: ~40 GB INT4 (комфортно на 2× RTX 5090, ~20 GB/GPU)
# Отлично для: высочайшее качество OCR, сложные документы, долгие контексты
# Hardware: 2× RTX 5090 (36 GB) — отличный запас для KV-кеша

MODEL_PATH=Qwen/Qwen2.5-VL-72B-Instruct-AWQ
MODEL_NAME=qwen25vl-72b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.80
DTYPE=float16
# Используем V0 движок для стабильности памяти
VLLM_USE_V1=0
EXTRA_ARGS="--trust-remote-code --quantization awq --enforce-eager --mm-processor-cache-gb 0"
MM_IMAGE_LIMIT=10
