# Qwen2.5-VL-72B AWQ — максимальное качество OCR/UI
# VRAM: ~40 GB INT4 (4×RTX 5060 Ti 16GB, впритык)
# --enforce-eager + малый контекст для экономии памяти на GPU 0 (визуальный энкодер)

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=Qwen/Qwen2.5-VL-72B-Instruct-AWQ
MODEL_NAME=qwen25vl-72b
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=2048
GPU_MEMORY_UTILIZATION=0.95
DTYPE=float16
EXTRA_ARGS="--trust-remote-code --quantization awq --enforce-eager"
MM_IMAGE_LIMIT=3
