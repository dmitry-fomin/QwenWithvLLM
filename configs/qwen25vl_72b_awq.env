# Qwen2.5-VL-72B AWQ — максимальное качество OCR/UI
# VRAM: ~40 GB INT4 (влезает, но с запасом минимальным)
# Отлично для: высочайшее качество OCR, сложные документы, долгие контексты

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=Qwen/Qwen2.5-VL-72B-Instruct-AWQ
MODEL_NAME=qwen25vl-72b
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
DTYPE=float16
EXTRA_ARGS="--trust-remote-code --quantization awq"
MM_IMAGE_LIMIT=10
