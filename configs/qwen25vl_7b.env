# Qwen2.5-VL-7B — альтернатива Qwen3-VL-8B
# VRAM: ~15 GB BF16 (помещается даже на 1 GPU)
# Отлично для: быстрая работа, современная архитектура, хорошая точность
# Hardware: 2× RTX 5090 (36 GB) — можно длинный контекст

MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct
MODEL_NAME=qwen25vl-7b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=20
