# Qwen2.5-VL-7B — альтернатива Qwen3-VL-8B, чуть проще
# VRAM: ~15 GB BF16
# Отлично для: быстрая работа, современная архитектура, хорошая точность

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct
MODEL_NAME=qwen25vl-7b
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=10
