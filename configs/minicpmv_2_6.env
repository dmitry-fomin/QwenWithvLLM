# MiniCPM-V 2.6 — лёгкая и быстрая, отличная OCR
# VRAM: ~17 GB BF16
# Отлично для: OCR до 1.8 млн пикселей, быстрое отклик время, мультиизображения

MODEL_PATH=openbmb/MiniCPM-V-2_6
MODEL_NAME=minicpmv-2_6
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code --limit-mm-per-prompt image=10"
