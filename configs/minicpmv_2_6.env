# MiniCPM-V 2.6 — лёгкая и быстрая, отличная OCR
# VRAM: ~17 GB BF16
# Отлично для: очень быстрая и легкая модель, хороший OCR для простых документов

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=openbmb/MiniCPM-V-2_6
MODEL_NAME=minicpmv-2_6
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.85
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=10
