# InternVL2.5-26B — тяжелая артиллерия для OCR/документов
# VRAM: ~52 GB BF16 → ~26 GB/GPU при TP=2
# Отлично для: максимум OCR без квантизации, мультиизображения, очень сложные задачи
# Hardware: 2× RTX 5090 (36 GB) — комфортный запас

MODEL_PATH=OpenGVLab/InternVL2_5-26B
MODEL_NAME=internvl2_5-26b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code"
MM_IMAGE_LIMIT=10
