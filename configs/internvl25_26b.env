# InternVL2.5-26B — тяжелая артиллерия для OCR/документов
# VRAM: ~52 GB BF16 → ~26 GB/GPU при TP=2
# Hardware: 2× RTX 5090 (32 GB) — ЗАПАС ЕСТЬ (нужно ~52 ГБ всего)

MODEL_PATH=OpenGVLab/InternVL2_5-26B
MODEL_NAME=internvl2_5-26b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.85
DTYPE=float16
# Используем FP8 для экономии памяти (26B на 32GB картах)
VLLM_USE_V1=0
EXTRA_ARGS="--trust-remote-code --quantization fp8 --mm-processor-cache-gb 0"
MM_IMAGE_LIMIT=10
