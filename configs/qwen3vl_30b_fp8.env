# [WARNING] Эта модель (Qwen3-VL-30B-FP8) на данный момент НЕСТАБИЛЬНА в vLLM nightly.
# Ошибка: ValueError: ... 192 is not divisible by weight quantization block_n = 128.
# Рекомендуется использовать: 
# - configs/qwen3vl_8b.env (BF16, очень стабильно)
# - configs/qwen25vl_72b_awq.env (AWQ, стабильно)

# Принудительно отключаем экспериментальный движок v1 (rewrite), который нестабилен с TP=4
VLLM_USE_V1=0

MODEL_PATH=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
MODEL_NAME=qwen3vl-30b-fp8
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DTYPE=auto
EXTRA_ARGS="--trust-remote-code --quantization fp8"
MM_IMAGE_LIMIT=10
