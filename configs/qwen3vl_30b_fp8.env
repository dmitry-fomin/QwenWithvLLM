# Qwen3-VL-30B-A3B FP8 — официальная квантованная версия от Qwen
# VRAM: ~31 GB FP8 (идеально влезает в 64GB, оставляя 30+ GB под контекст)
# Отлично для: высокая скорость (MoE), нативная поддержка vLLM

MODEL_PATH=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
MODEL_NAME=qwen3vl-30b-fp8
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DTYPE=auto
EXTRA_ARGS="--trust-remote-code --quantization fp8"
MM_IMAGE_LIMIT=10
