# DeepSeek-R1-Distill-Qwen-32B W4A16 (neuralmagic) — лучший reasoning в классе <64B
# VRAM: ~20 GB INT4 → ~10 GB/GPU при TP=2 — огромный запас на KV-кеш
# Особенности: только текст, chain-of-thought reasoning, ~= o1 на math/code
# Квантизация: compressed-tensors W4A16 (INT4 веса, BF16 активации)

MODEL_PATH=neuralmagic/DeepSeek-R1-Distill-Qwen-32B-quantized.w4a16
MODEL_NAME=deepseek-r1-32b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DTYPE=bfloat16
EXTRA_ARGS="--trust-remote-code --quantization compressed-tensors"
